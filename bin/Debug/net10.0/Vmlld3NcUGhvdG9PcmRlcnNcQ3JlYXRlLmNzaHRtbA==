@model DigitalPhotoPrintingSystem.Models.PhotoOrder

@{
    ViewData["Title"] = "Create Photo Order";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Upload Photo & Order</h4>
                </div>
                <div class="card-body">
                    <!-- enctype MUST be multipart/form-data for image upload -->
                    <form asp-controller="PhotoOrder" asp-action="Create" method="post" enctype="multipart/form-data">

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Select Photo</label>
                            <input type="file" name="photoFile" class="form-control" accept="image/*" required />
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Print Size</label>
                            <select name="PrintSize" class="form-select" required>
                                <option value="">-- Select Size --</option>
                                <option value="4x6">4 x 6 inches</option>
                                <option value="5x7">5 x 7 inches</option>
                                <option value="8x10">8 x 10 inches</option>
                            </select>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Quantity</label>
                            <input type="number" name="Quantity" value="1" min="1" max="50" class="form-control" required />
                        </div>

                        <button type="submit" class="btn btn-success w-100">Submit Order</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>