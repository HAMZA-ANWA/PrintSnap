<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PrintSnap Digital Studio</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Glossy Shine & Smooth Nav Link Styles -->
    <style>
        .btn-glossy-shine {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        border-radius: 0.85rem;
        box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4);
        transition: all 0.3s ease;
        }

        .btn-glossy-outline {
        position: relative;
        overflow: hidden;
        background: rgba(15, 23, 42, 0.8);
        border: 1px solid rgba(99, 102, 241, 0.5);
        border-radius: 0.85rem;
        transition: all 0.3s ease;
        }

        .btn-glossy-shine::before, .btn-glossy-outline::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(60deg, transparent 30%, rgba(255, 255, 255, 0.4) 50%, transparent 70%);
        transform: rotate(30deg) translateY(-100%);
        transition: all 0.75s ease-in-out;
        }

        .btn-glossy-shine:hover::before, .btn-glossy-outline:hover::before {
        transform: rotate(30deg) translateY(100%);
        }

        .btn-glossy-shine:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(168, 85, 247, 0.6);
        }

        .btn-glossy-outline:hover {
        transform: translateY(-2px);
        border-color: #a855f7;
        box-shadow: 0 4px 15px rgba(168, 85, 247, 0.4);
        }

        /* Ultra Smooth Custom Underline Animation */
        .nav-link {
        position: relative;
        padding-bottom: 6px;
        transition: color 0.3s ease;
        }

        .nav-link::after {
        content: '';
        position: absolute;
        width: 0%;
        height: 2.5px;
        bottom: 0;
        left: 50%;
        background: linear-gradient(90deg, #6366f1, #a855f7);
        border-radius: 99px;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        transform: translateX(-50%);
        opacity: 0;
        }

        .nav-link:hover::after, .nav-link:focus::after, .nav-link.active::after {
        width: 100%;
        opacity: 1;
        }

        <style >
            /* Global Date Picker Calendar Icon Fix (Pure White & Glowing) */
            input[type="date"] {
            color-scheme: dark !important;
            }

            input[type="date"]::-webkit-calendar-picker-indicator {
            filter: invert(100%) sepia(0%) saturate(0%) hue-rotate(0deg) brightness(200%) contrast(100%) !important;
            cursor: pointer !important;
            opacity: 1 !important;
            }

            input[type="date"]::-webkit-calendar-picker-indicator:hover {
            transform: scale(1.15) !important;
            filter: invert(100%) brightness(300%) drop-shadow(0 0 6px rgba(255, 255, 255, 0.9)) !important;
            }
        </style>git
    </style>
</head>
<body class="bg-[#0b0f19] text-white font-sans min-h-screen flex flex-col justify-between">

    <!-- Header / Navbar -->
    <header class="bg-[#0b0f19]/90 border-b border-slate-800 sticky top-0 z-50 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">

                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 group">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white text-2xl shadow-lg shadow-indigo-500/30 group-hover:scale-105 transition">
                        <i class="fa-solid fa-camera"></i>
                    </div>
                    <div>
                        <span class="text-2xl font-black tracking-tight text-white block leading-none">PrintSnap</span>
                        <span class="text-[10px] text-indigo-400 font-bold tracking-widest uppercase block mt-1">Digital Studio</span>
                    </div>
                </a>

                <!-- Navigation Links -->
                <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
                    <a asp-controller="Home" asp-action="Index" class="nav-link hover:text-white flex items-center gap-2">
                        <i class="fa-solid fa-house text-indigo-400"></i> Home
                    </a>
                    <a asp-controller="Admin" asp-action="Dashboard" class="nav-link hover:text-white flex items-center gap-2">
                        <i class="fa-solid fa-chart-line text-indigo-400"></i> Dashboard
                    </a>
                    <a asp-controller="Admin" asp-action="ManageOrders" class="nav-link hover:text-white flex items-center gap-2">
                        <i class="fa-solid fa-list-check text-indigo-400"></i> Manage Orders
                    </a>
                    <a asp-controller="Admin" asp-action="ManagePrices" class="nav-link hover:text-white flex items-center gap-2">
                        <i class="fa-solid fa-tags text-indigo-400"></i> Manage Prices
                    </a>

                </nav>

                <!-- Auth Buttons & Actions -->
                <div class="flex items-center gap-3">
                    @if (Context.Session.GetString("UserName") != null)
                    {
                        <div class="bg-indigo-950/60 border border-indigo-500/30 px-4 py-2 rounded-2xl flex items-center gap-2 text-sm text-indigo-200">
                            <i class="fa-solid fa-circle-user text-indigo-400 text-lg"></i>
                            <span class="font-semibold">@Context.Session.GetString("UserName")</span>
                        </div>

                        <a asp-controller="Account" asp-action="Logout" class="bg-rose-500/10 hover:bg-rose-600 text-rose-400 hover:text-white border border-rose-500/20 px-4 py-2 rounded-2xl text-sm font-semibold transition">
                            <i class="fa-solid fa-right-from-bracket"></i> Logout
                        </a>
                    }
                    else
                    {
                        <!-- GLOSSY LOGIN BUTTON -->
                        <a asp-controller="Account" asp-action="Login" class="btn-glossy-outline px-5 py-2 text-sm font-semibold text-white">
                            Login
                        </a>

                        <!-- GLOSSY REGISTER BUTTON -->
                        <a asp-controller="Account" asp-action="Register" class="btn-glossy-outline px-5 py-2 text-sm font-semibold text-white">
                            Register
                        </a>
                    }

                    <!-- GLOSSY PRINT PHOTOS BUTTON (FIXED CONTROLLER LINK) -->
                    <a asp-controller="PhotoOrders" asp-action="Create" class="btn-glossy-shine px-5 py-2.5 text-sm font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-print"></i> Print Photos
                    </a>
                </div>

            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main role="main" class="flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-[#070b14] border-t border-slate-800 py-6 text-center text-xs text-slate-500">
        <div class="max-w-7xl mx-auto px-4">
            <p>&copy; @DateTime.Now.Year PrintSnap Digital Photo Printing. All Rights Reserved.</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>