<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PrintSnap Digital Studio</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <!-- Google Fonts (Inter) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
        font-family: 'Inter', sans-serif;
        background-color: #0b0f19;
        color: #f8fafc;
        }

        /* Modern Glass Navbar */
        .pro-navbar {
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(12px);
        border-bottom: 2px solid #e2e8f0;
        }




        /* Professional Animated Underline Links */
        .nav-link-pro {
        position: relative;
        color: #334155;
        font-weight: 600;
        padding: 0.6rem 0.5rem;
        transition: color 0.3s ease;
        }

        .nav-link-pro::after {
        content: '';
        position: absolute;
        width: 0%;
        height: 3px;
        bottom: 0;
        left: 0;
        background: linear-gradient(90deg, #4f46e5, #7c3aed);
        border-radius: 99px;
        transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .nav-link-pro:hover {
        color: #4f46e5;
        }

        .nav-link-pro:hover::after {
        width: 100%;
        }

        /* ULTRA PROFESSIONAL GLOW LIGHT BEAM BUTTONS (SHIMMER EFFECT) */
        .glow-btn-container {
        position: relative;
        overflow: hidden;
        border-radius: 9999px;
        transition: all 0.3s ease;
        }

        /* Top-to-Bottom Light Beam Animation */
        .glow-btn-container::before {
        content: '';
        position: absolute;
        top: -150%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient( to bottom, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.6) 50%, rgba(255, 255, 255, 0) 100% );
        transform: rotate(30deg);
        transition: all 0.6s ease;
        opacity: 0;
        pointer-events: none;
        }

        /* Trigger Light Beam Effect on Hover & Click (Active) */
        .glow-btn-container:hover::before,
        .glow-btn-container:active::before {
        top: 150%;
        opacity: 1;
        }

        /* Login Button Style */
        .btn-login-glow {
        border: 2px solid #cbd5e1;
        color: #1e293b;
        font-weight: 700;
        padding: 0.55rem 1.4rem;
        background: #f8fafc;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        }

        .glow-btn-container:hover .btn-login-glow {
        border-color: #6366f1;
        color: #4f46e5;
        box-shadow: 0 0 15px rgba(99, 102, 241, 0.3);
        }

        /* Print Photos Main Button Style */
        .btn-print-glow {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        color: white !important;
        font-weight: 700;
        padding: 0.65rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 4px 15px rgba(79, 70, 229, 0.4);
        }

        .glow-btn-container:hover .btn-print-glow {
        box-shadow: 0 0 25px rgba(124, 58, 237, 0.7);
        transform: scale(1.02);
        }

        .glow-btn-container:active {
        transform: scale(0.96);
        }
    </style>
</head>
<body class="flex flex-col min-h-screen">

    <!-- Header Navigation -->
    <nav class="sticky top-0 z-50 pro-navbar shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20 items-center">

                <!-- Modern Brand Logo -->
                <a class="flex items-center space-x-3 group" href="/">
                    <div class="p-2.5 bg-gradient-to-tr from-indigo-600 to-purple-600 text-white rounded-xl shadow-md group-hover:scale-105 transition transform duration-200">
                        <i class="fa-solid fa-camera-retro text-xl"></i>
                    </div>
                    <div>
                        <span class="text-2xl font-extrabold tracking-tight text-slate-900">Print<span class="text-indigo-600">Snap</span></span>
                        <span class="block text-[10px] font-bold tracking-widest text-indigo-500 uppercase -mt-1">Digital Studio</span>
                    </div>
                </a>

                <!-- Navigation Links with Animated Gradient Underlines -->
                <div class="hidden md:flex items-center space-x-6 text-sm">
                    <a class="nav-link-pro flex items-center gap-2" href="/">
                        <i class="fa-solid fa-house text-indigo-500"></i> Home
                    </a>
                    <a class="nav-link-pro flex items-center gap-2" href="/PhotoOrder/Create">
                        <i class="fa-solid fa-circle-plus text-indigo-500"></i> New Order
                    </a>
                    <a class="nav-link-pro flex items-center gap-2" href="/PhotoOrder/ManageOrders">
                        <i class="fa-solid fa-list-check text-indigo-500"></i> Manage Orders
                    </a>
                    <a class="nav-link-pro flex items-center gap-2" href="/Admin/ManagePrices">
                        <i class="fa-solid fa-tags text-indigo-500"></i> Manage Prices
                    </a>
                </div>

                <!-- Right Action Buttons with Light Beam Effect -->
                <div class="flex items-center space-x-3">

                    <!-- Login Glow Button -->
                    <div class="glow-btn-container">
                        <a href="/Account/Login" class="btn-login-glow text-sm">
                            <i class="fa-regular fa-user"></i> Login
                        </a>
                    </div>

                    <!-- Print Photos Beam Button -->
                    <div class="glow-btn-container">
                        <a href="/PhotoOrder/Create" class="btn-print-glow text-sm">
                            <i class="fa-solid fa-print"></i> Print Photos
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </nav>

    <!-- Main Content Body -->
    <main class="flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 text-slate-400 py-8 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 text-center text-sm">
            <p>&copy; @DateTime.Now.Year PrintSnap Digital Studio. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>








