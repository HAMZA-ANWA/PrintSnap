@model DigitalPhotoPrintingSystem.Models.OrderViewModel

@{
    ViewData["Title"] = "Create New Order";
}

<div class="max-w-4xl mx-auto px-4 py-12">
    <div class="bg-white rounded-2xl shadow-xl border border-slate-200/80 overflow-hidden">
        <div class="bg-slate-900 text-white p-8">
            <h2 class="text-2xl font-bold"><i class="fa-solid fa-cart-plus text-indigo-400 mr-2"></i> Create Photo Print Order</h2>
            <p class="text-slate-400 text-sm mt-1">Provide your order details, select size, and upload JPEG photos.</p>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data" class="p-8 space-y-6">
            @Html.AntiForgeryToken()

            <div class="grid md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Customer Email</label>
                    <input asp-for="CustomerEmail" type="email" class="form-control rounded-xl py-2.5 border-slate-300 focus:ring-2 focus:ring-indigo-500" placeholder="name@example.com" required />
                </div>

                <div>

                    <label class="block text-sm font-semibold text-slate-700 mb-2">Print Size</label>
                    <select asp-for="PrintSizeId" class="form-select rounded-xl py-2.5 border-slate-300 focus:ring-2 focus:ring-indigo-500" required>
                        <option value="">-- Select Size --</option>
                        <option value="1">4 x 6 Inches</option>
                        <option value="2">8 x 10 Inches</option>
                        <option value="3">10 x 12 Inches</option>
                    </select>
                </div>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Number of Copies Per Photo</label>
                    <input asp-for="Copies" type="number" min="1" value="1" class="form-control rounded-xl py-2.5 border-slate-300" required />
                </div>

                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Payment Option</label>
                    <select asp-for="PaymentMode" class="form-select rounded-xl py-2.5 border-slate-300" required>
                        <option value="DirectBranch">Direct Payment in Branch</option>
                        <option value="CreditCard">Credit Card</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Credit Card Number (Optional if Branch)</label>
                <input asp-for="CreditCardNumber" type="text" maxlength="20" class="form-control rounded-xl py-2.5 border-slate-300" placeholder="XXXX-XXXX-XXXX-XXXX" />
            </div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Shipping Address</label>
                <textarea asp-for="ShippingAddress" rows="2" class="form-control rounded-xl border-slate-300" placeholder="Full delivery address..." required></textarea>
            </div>

            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Upload JPEG Photographs (Req RS1)</label>
                <div class="border-2 border-dashed border-indigo-200 bg-indigo-50/50 hover:bg-indigo-50 p-6 rounded-2xl text-center">
                    <i class="fa-solid fa-cloud-arrow-up text-3xl text-indigo-500 mb-2"></i>
                    <p class="text-sm font-medium text-slate-600">Choose JPEG files from your local folder</p>
                    <input asp-for="Photos" type="file" multiple accept=".jpg,.jpeg" class="mt-3 block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-indigo-600 file:text-white hover:file:bg-indigo-700" required />
                </div>
            </div>

           <!-- CSS Style Button Ke Liye -->

<!-- Submit Button Code -->
<div class="pt-4 border-t border-slate-200">
    <button type="submit" class="w-full btn-glossy-shine py-3.5 text-base font-bold text-white flex items-center justify-center gap-2">
        <i class="fa-solid fa-paper-plane"></i>
        <span>Submit Order & Calculate Total</span>
    </button>
</div>
        </form>
    </div>
</div>





















