@{
    ViewData["Title"] = "Order Success";
}

<div class="container mt-5 text-center">
    <div class="card shadow p-4 mx-auto" style="max-width: 600px;">
        <div class="text-success mb-3">
            <h1 class="display-3">✓</h1>
        </div>
        <h2 class="text-success">Order Placed Successfully!</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mt-3 shadow-sm">
                <strong>Success!</strong> @TempData["Success"]
            </div>
        }

        <p class="mt-3 text-muted">Your photo print request and purchase order have been created in the database. Thank you for using MyImage!</p>

        <div class="mt-4">
            <a href="/" class="btn btn-primary px-4">Back to Home</a>
            <a href="/PhotoOrder/Create" class="btn btn-outline-secondary px-4 ms-2">Order More Photos</a>
        </div>
    </div>
</div>