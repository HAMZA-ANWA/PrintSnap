@{
    ViewData["Title"] = "Home Page";
}

<style>
    /* Light Beam Shimmer Animation Container */
    .glow-btn-container {
        position: relative;
        overflow: hidden;
        border-radius: 9999px;
        transition: all 0.3s ease;
        display: inline-block;
    }

        .glow-btn-container::before {
            content: '';
            position: absolute;
            top: -150%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient( to bottom, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.6) 50%, rgba(255, 255, 255, 0) 100% );
            transform: rotate(30deg);
            transition: all 0.6s ease;
            opacity: 1;
            pointer-events: none;
        }

        .glow-btn-container:hover::before,
        .glow-btn-container:active::before {
            top: 150%;
            opacity: 1;
        }

    /* Start Printing Main Hero Button */
    .btn-hero-primary {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        color: white !important;
        font-weight: 700;
        padding: 0.85rem 2rem;
        box-shadow: 0 10px 25px rgba(99, 102, 241, 0.4);
    }

    .glow-btn-container:hover .btn-hero-primary {
        box-shadow: 0 0 30px rgba(168, 85, 247, 0.7);
        transform: scale(1.02);
    }

    /* Admin Portal Beam Button */
    .btn-admin-beam {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(8px);
        border: 2px solid rgba(255, 255, 255, 0.3);
        color: white !important;
        font-weight: 900;
        padding: 0.8rem 2rem;
    }

    .glow-btn-container:hover .btn-admin-beam {
        border-color: #a855f7;
        background: rgba(168, 85, 247, 0.2);
        box-shadow: 0 0 25px rgba(168, 85, 247, 0.5);
    }

    /* Ultra Professional Feature Cards */
    .pro-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1.25rem;
        padding: 2rem;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

        .pro-card:hover {
            transform: translateY(-8px);
            border-color: #6366f1;
            box-shadow: 0 20px 30px -10px rgba(99, 102, 241, 0.2);
        }
</style>

<!-- HERO BANNER SECTION -->
<div class="relative bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white py-24 px-4 overflow-hidden">
    <!-- Subtle Background Glow -->
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto text-center relative z-10">

        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 mb-6 uppercase tracking-wider">
            <i class="fa-solid fa-bolt text-yellow-400"></i> Fast & Premium Quality
        </span>

        <h1 class="text-4xl md:text-6xl font-black tracking-tight mb-6 leading-tight">
            Turn Your Digital Memories <br />
            <span class="bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent">
                Into Physical Prints
            </span>
        </h1>

        <p class="max-w-2xl mx-auto text-slate-300 text-base md:text-lg mb-10 font-medium">
            Upload JPEG photographs directly from your desktop, choose customized print sizes, calculate exact costs instantly, and receive high-grade photo prints shipped to your door.
        </p>

        <!-- Both Hero Buttons with Light Beam Effect -->
        <div class="flex flex-wrap justify-center gap-4">

            <!-- Start Printing Now Button -->
            <div class="glow-btn-container">
                <a href="/PhotoOrder/Create" class="btn-hero-primary flex items-center gap-3">
                    <i class="fa-solid fa-print"></i> Start Printing Now <i class="fa-solid fa-arrow-right text-sm"></i>
                </a>
            </div>

            <!-- Admin Portal Beam Button -->
            <div class="glow-btn-container">
                <a href="/PhotoOrder/ManageOrders" class="btn-admin-beam flex items-center gap-3">
                    <i class="fa-solid fa-user-shield"></i> Admin Portal
                </a>
            </div>

        </div>

    </div>
</div>

<!-- FEATURE CARDS SECTION -->
<div class="bg-slate-50 py-20 px-4 border-t border-slate-200">
    <div class="max-w-7xl mx-auto">

        <div class="text-center mb-14">
            <h2 class="text-3xl font-extrabold text-slate-900">Why Choose PrintSnap?</h2>
            <p class="text-slate-500 mt-2">Built for speed, simplicity, and complete order isolation security.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">

            <!-- Card 1 -->
            <div class="pro-card group">
                <div class="w-14 h-14 bg-indigo-100 text-indigo-600 rounded-2xl flex items-center justify-center text-2xl mb-6 group-hover:bg-indigo-600 group-hover:text-white transition duration-300">
                    <i class="fa-regular fa-folder-open"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">Folder Upload</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-6">
                    Select JPEG photos from your local folder seamlessly with automated folder isolation (RS1 Requirement).
                </p>
                <a href="/PhotoOrder/Create" class="inline-flex items-center gap-2 text-sm font-bold text-indigo-600 hover:text-indigo-800">
                    Try Folder Select <i class="fa-solid fa-chevron-right text-xs"></i>
                </a>
            </div>

            <!-- Card 2 -->
            <div class="pro-card group">
                <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center text-2xl mb-6 group-hover:bg-emerald-600 group-hover:text-white transition duration-300">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">Encrypted Checkout</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-6">
                    Credit card data is encrypted on the client side before submission for maximum ecommerce security (RS3 Requirement).
                </p>
                <a href="/PhotoOrder/Create" class="inline-flex items-center gap-2 text-sm font-bold text-emerald-600 hover:text-emerald-800">
                    Secure Order <i class="fa-solid fa-chevron-right text-xs"></i>
                </a>
            </div>

            <!-- Card 3 -->
            <div class="pro-card group">
                <div class="w-14 h-14 bg-purple-100 text-purple-600 rounded-2xl flex items-center justify-center text-2xl mb-6 group-hover:bg-purple-600 group-hover:text-white transition duration-300">
                    <i class="fa-solid fa-broom"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">Auto Server Cleanup</h3>
                <p class="text-slate-600 text-sm leading-relaxed mb-6">
                    Server folders are auto-deleted after order fulfillment to maintain strict data privacy (Req 10 Requirement).
                </p>
                <a href="/PhotoOrder/ManageOrders" class="inline-flex items-center gap-2 text-sm font-bold text-purple-600 hover:text-purple-800">
                    View Manager <i class="fa-solid fa-chevron-right text-xs"></i>
                </a>
            </div>

        </div>
    </div>
</div>

<!-- NEW SECTION: HOW IT WORKS (3 EASY STEPS) -->
<div class="bg-white py-20 px-4 border-t border-slate-100">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <span class="text-indigo-600 font-extrabold text-xs tracking-widest uppercase">Simple Process</span>
            <h2 class="text-3xl font-extrabold text-slate-900 mt-1">How It Works in 3 Steps</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8 text-center">

            <div class="p-6">
                <div class="w-12 h-12 bg-indigo-600 text-white font-black text-xl rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg shadow-indigo-200">1</div>
                <h4 class="font-bold text-slate-900 text-lg mb-2">Pick JPEG Photos</h4>
                <p class="text-slate-500 text-sm">Choose photos directly from your computer storage.</p>
            </div>

            <div class="p-6">
                <div class="w-12 h-12 bg-purple-600 text-white font-black text-xl rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg shadow-purple-200">2</div>
                <h4 class="font-bold text-slate-900 text-lg mb-2">Set Sizes & Quantities</h4>
                <p class="text-slate-500 text-sm">Customize photo dimensions (4x6, 8x10) and total copies.</p>
            </div>

            <div class="p-6">
                <div class="w-12 h-12 bg-emerald-600 text-white font-black text-xl rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg shadow-emerald-200">3</div>
                <h4 class="font-bold text-slate-900 text-lg mb-2">Encrypted Checkout</h4>
                <p class="text-slate-500 text-sm">Pay securely and get order tracking ID generated instantly.</p>
            </div>

        </div>
    </div>
</div>

<!-- NEW SECTION: BOTTOM CALL TO ACTION BANNER -->
<div class="bg-gradient-to-r from-indigo-900 to-purple-900 text-white py-16 px-4">
    <div class="max-w-5xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Print Your Favorite Memories?</h2>
        <p class="text-indigo-200 mb-8 max-w-xl mx-auto text-sm">Instant price calculation, client-side encryption, and automated dispatch.</p>

        <div class="glow-btn-container">
            <a href="/PhotoOrder/Create" class="btn-hero-primary flex items-center gap-2">
                <i class="fa-solid fa-camera"></i> Create Print Order Now
            </a>
        </div>
    </div>
</div>