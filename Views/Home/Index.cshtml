@{
    ViewData["Title"] = "MyImage - Digital Photo Printing";
}

<style>
    /* 1. DATE CALENDAR ICON FIX (FORCED WHITE & VISIBLE) */
    input[type="date"] {
        color-scheme: dark !important;
    }

        input[type="date"]::-webkit-calendar-picker-indicator {
            filter: invert(1) brightness(2) !important; /* Forces calendar icon to be pure white */
            cursor: pointer !important;
            opacity: 0.9 !important;
            transition: transform 0.3s ease, filter 0.3s ease !important;
        }

            input[type="date"]::-webkit-calendar-picker-indicator:hover {
                opacity: 1 !important;
                transform: scale(1.2) !important;
                filter: invert(1) brightness(3) drop-shadow(0 0 5px rgba(255, 255, 255, 0.8)) !important;
            }

    /* 2. ULTRA GLOSSY & SMOOTH BUTTON STYLES */

    /* Primary Glossy Button (Start Printing Now) */
    .vip-primary-btn {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #d946ef 100%);
        border-radius: 1rem;
        padding: 0.875rem 2rem;
        font-weight: 700;
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.35);
        /* 3D Glass Layer + Glow */
        box-shadow: inset 0 2px 2px rgba(255, 255, 255, 0.6), inset 0 -2px 4px rgba(0, 0, 0, 0.2), 0 8px 20px -4px rgba(168, 85, 247, 0.5);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); /* Slow smooth spring ease */
    }

        /* Glossy Light Reflection Effect */
        .vip-primary-btn::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 48%;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.05) 100%);
            border-radius: 1rem 1rem 0 0;
            pointer-events: none;
        }

        .vip-primary-btn:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: inset 0 2px 4px rgba(255, 255, 255, 0.8), 0 14px 30px -4px rgba(168, 85, 247, 0.7);
            filter: brightness(1.1);
        }

        .vip-primary-btn:active {
            transform: translateY(1px) scale(0.97);
            box-shadow: inset 0 3px 6px rgba(0, 0, 0, 0.3);
            transition: all 0.15s ease;
        }


    /* Secondary Glossy Button (Admin Portal) */
    .vip-secondary-btn {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(30, 41, 59, 0.85) 0%, rgba(15, 23, 42, 0.95) 100%);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 1rem;
        padding: 0.875rem 1.75rem;
        font-weight: 700;
        color: #f8fafc;
        backdrop-filter: blur(16px);
        box-shadow: inset 0 2px 2px rgba(255, 255, 255, 0.25), inset 0 -2px 4px rgba(0, 0, 0, 0.4), 0 6px 18px rgba(0, 0, 0, 0.4);
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); /* Slow smooth ease */
    }

        .vip-secondary-btn::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 48%;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.02) 100%);
            border-radius: 1rem 1rem 0 0;
            pointer-events: none;
        }

        .vip-secondary-btn:hover {
            transform: translateY(-3px) scale(1.03);
            border-color: rgba(168, 85, 247, 0.7);
            background: linear-gradient(135deg, rgba(45, 55, 78, 0.9) 0%, rgba(20, 30, 50, 0.98) 100%);
            box-shadow: inset 0 2px 4px rgba(255, 255, 255, 0.4), 0 12px 25px -4px rgba(99, 102, 241, 0.4);
            color: #ffffff;
        }

        .vip-secondary-btn:active {
            transform: translateY(1px) scale(0.97);
            box-shadow: inset 0 3px 6px rgba(0, 0, 0, 0.4);
            transition: all 0.15s ease;
        }


    /* Requirement Cards Styling */
    .custom-spec-card {
        background: #0b0f19;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 1.25rem;
        padding: 1.75rem;
        transition: all 0.3s ease;
    }

        .custom-spec-card:hover {
            border-color: rgba(99, 102, 241, 0.4);
            box-shadow: 0 8px 20px -5px rgba(99, 102, 241, 0.15);
            transform: translateY(-3px);
        }
</style>

<!-- Hero Banner -->
<div class="relative bg-slate-900/90 text-white rounded-3xl overflow-hidden shadow-lg shadow-black/20 my-6 border border-slate-800">
    <div class="absolute inset-0 bg-gradient-to-r from-indigo-950/30 via-slate-900 to-purple-950/30 pointer-events-none"></div>

    <div class="relative max-w-4xl mx-auto text-center py-16 px-6">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-400/20 text-indigo-300 text-xs font-semibold tracking-wide uppercase mb-8">
            <i class="fa-solid fa-bolt text-indigo-400"></i> MYIMAGE STUDIO • FAST & PREMIUM QUALITY
        </div>

        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white mb-6">
            Turn Your Digital Memories <br />
            <span class="bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent">
                Into Physical Prints
            </span>
        </h1>

        <p class="text-base md:text-lg text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
            Upload JPEG photographs directly from your desktop, choose customized print sizes, calculate exact costs instantly, and receive high-grade photo prints shipped to your door.
        </p>

        <!-- Glossy Action Buttons -->
        <div class="flex flex-wrap justify-center items-center gap-4">
            <a asp-controller="PhotoOrders" asp-action="Create" class="vip-primary-btn inline-flex items-center justify-center text-base">
                <i class="fa-solid fa-print mr-2.5"></i> Start Printing Now
                <i class="fa-solid fa-arrow-right ml-2 text-sm"></i>
            </a>

            <a href="/Admin/ManageOrders" class="vip-secondary-btn inline-flex items-center justify-center text-base">
                <i class="fa-solid fa-user-shield mr-2 text-indigo-400"></i> Admin Portal
            </a>
        </div>
    </div>
</div>

<!-- Customer Requirements RS1-RS6 Cards -->
<div class="py-10 mb-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="custom-spec-card">
            <div class="w-11 h-11 rounded-xl bg-purple-600/80 flex items-center justify-center text-white text-lg shadow-sm mb-6">
                <i class="fa-solid fa-images"></i>
            </div>
            <span class="text-xs font-bold text-purple-400 uppercase tracking-widest block mb-1">REQUIREMENT RS1</span>
            <h3 class="text-xl font-bold text-white mb-3">JPEG Upload System</h3>
            <p class="text-slate-400 text-sm leading-relaxed">
                Browse desktop folders and automatically filter/select high-quality JPEG photograph files for printing.
            </p>
        </div>

        <div class="custom-spec-card">
            <div class="w-11 h-11 rounded-xl bg-pink-600/80 flex items-center justify-center text-white text-lg shadow-sm mb-6">
                <i class="fa-solid fa-calculator"></i>
            </div>
            <span class="text-xs font-bold text-pink-400 uppercase tracking-widest block mb-1">REQUIREMENT RS2</span>
            <h3 class="text-xl font-bold text-white mb-3">Instant Cost Engine</h3>
            <p class="text-slate-400 text-sm leading-relaxed">
                Automated order cost calculation based on selected print dimensions (4x6, 8x10) and total copies.
            </p>
        </div>

        <div class="custom-spec-card">
            <div class="w-11 h-11 rounded-xl bg-rose-500/80 flex items-center justify-center text-white text-lg shadow-sm mb-6">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <span class="text-xs font-bold text-rose-400 uppercase tracking-widest block mb-1">REQUIREMENT RS3</span>
            <h3 class="text-xl font-bold text-white mb-3">Encrypted Payment</h3>
            <p class="text-slate-400 text-sm leading-relaxed">
                Secure credit card encryption before server verification, or optional direct branch payment mode.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="custom-spec-card">
            <div class="w-11 h-11 rounded-xl bg-indigo-600/80 flex items-center justify-center text-white text-lg shadow-sm mb-6">
                <i class="fa-solid fa-folder-closed"></i>
            </div>
            <span class="text-xs font-bold text-indigo-400 uppercase tracking-widest block mb-1">REQUIREMENT RS4</span>
            <h3 class="text-xl font-bold text-white mb-3">Purchase Order & Folders</h3>
            <p class="text-slate-400 text-sm leading-relaxed">
                Auto-generate unique purchase order IDs (1-1000) and create dedicated server storage folders (`folder_xxxx`).
            </p>
        </div>

        <div class="custom-spec-card">
            <div class="w-11 h-11 rounded-xl bg-cyan-600/80 flex items-center justify-center text-white text-lg shadow-sm mb-6">
                <i class="fa-solid fa-user-gear"></i>
            </div>
            <span class="text-xs font-bold text-cyan-400 uppercase tracking-widest block mb-1">REQUIREMENT RS5</span>
            <h3 class="text-xl font-bold text-white mb-3">Admin Management</h3>
            <p class="text-slate-400 text-sm leading-relaxed">
                Administrator dashboard to view orders, update print prices, execute requests, and handle shipping.
            </p>
        </div>

        <div class="custom-spec-card">
            <div class="w-11 h-11 rounded-xl bg-emerald-600/80 flex items-center justify-center text-white text-lg shadow-sm mb-6">
                <i class="fa-solid fa-trash-can"></i>
            </div>
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-widest block mb-1">REQUIREMENT RS6</span>
            <h3 class="text-xl font-bold text-white mb-3">Auto Server Cleanup</h3>
            <p class="text-slate-400 text-sm leading-relaxed">
                Automatic deletion of printed photo directories from the server once orders are marked as completed & shipped.
            </p>
        </div>
    </div>
</div>



