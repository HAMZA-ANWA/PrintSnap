@model IEnumerable<DigitalPhotoPrintingSystem.Models.PhotoOrder>

@{
    ViewData["Title"] = "Manage Orders";
}

<div class="container my-4">
    <h2 class="mb-4">Customer Orders</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm p-3">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Order #</th>
                    <th>Customer Name</th>
                    <th>Email</th>
                    <th>Size</th>
                    <th>Qty</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td>@item.CustomerName</td>
                            <td>@item.EmailId</td>
                            <td>@item.PrintSize</td>
                            <td>@item.Quantity</td>
                            <td>$@item.TotalPrice</td>
                            <td>
                                @if (item.Status == "Shipped")
                                {
                                    <span class="badge bg-success">Shipped</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@item.Status</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.Status != "Shipped")
                                {
                                    <form asp-controller="Admin" asp-action="ShipOrder" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Are you sure you want to mark this order as Shipped? High-res photo files will be deleted to save space.');">
                                            <i class="fa-solid fa-truck"></i> Ship & Clear Files
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Files Cleared</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">No orders found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>