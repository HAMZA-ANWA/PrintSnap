@model IEnumerable<DigitalPhotoPrintingSystem.Models.PrintPrice>

@{
    ViewData["Title"] = "Manage Print Prices";
}

<div class="container mt-4">
    <h2>Manage Print Sizes & Prices (Requirement 2 & 11)</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Add Price Form -->
    <div class="card my-4">
        <div class="card-header bg-primary text-white">Add New Print Size & Price</div>
        <div class="card-body">
            <form asp-controller="Admin" asp-action="AddPrice" method="post" class="row g-3">
                <div class="col-md-5">
                    <label class="form-label">Print Size (e.g., 4x6, 10x12)</label>
                    <input type="text" name="SizeName" class="form-control" placeholder="4x6 Inches" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Price (PKR)</label>
                    <input type="number" step="0.01" name="Price" class="form-control" placeholder="0.50" required />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">Add Price</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Prices Table -->
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Size Name</th>
                <th>Price (PKR)</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.SizeName</td>
                        <td>$@item.Price</td>
                        <td>
                            <form asp-controller="Admin" asp-action="DeletePrice" method="post" onsubmit="return confirm('Are you sure you want to delete this print size?');">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">No print sizes configured yet. Add one above!</td>
                </tr>
            }
        </tbody>
    </table>
</div>