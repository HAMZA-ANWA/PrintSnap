@model IEnumerable<DigitalPhotoPrintingSystem.Models.PrintPrice>

@{
    ViewData["Title"] = "Manage Print Prices";
}

<div class="container py-8">
    <h2 class="text-2xl font-bold text-white mb-4">Manage Print Sizes & Prices (Requirement 2 & 11)</h2>

    @if (TempData["Success"] != null)
    {
        <div class="p-4 mb-4 text-sm text-emerald-400 bg-emerald-950 border border-emerald-800 rounded-xl" role="alert">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="p-4 mb-4 text-sm text-rose-400 bg-rose-950 border border-rose-800 rounded-xl" role="alert">
            @TempData["Error"]
        </div>
    }

    <!-- Add Price Form -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 mb-8 shadow-xl">
        <h3 class="text-lg font-bold text-indigo-400 mb-4">Add New Print Size & Price</h3>
        <form asp-controller="Admin" asp-action="AddPrice" method="post" class="grid grid-cols-1 md:grid-cols-12 gap-4">
            <div class="md:col-span-5">
                <label class="block text-xs font-semibold text-slate-400 mb-2">Print Size (e.g., 4x6, 10x12)</label>
                <input type="text" name="SizeName" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-indigo-500" placeholder="4x6 Inches" required />
            </div>
            <div class="md:col-span-5">
                <label class="block text-xs font-semibold text-slate-400 mb-2">Price (PKR / USD)</label>
                <input type="number" step="0.01" name="Price" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-indigo-500" placeholder="0.50" required />
            </div>
            <div class="md:col-span-2 flex items-end">
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 px-4 rounded-xl transition">Add Price</button>
            </div>
        </form>
    </div>

    <!-- Prices Table -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
        <table class="w-full text-left text-sm text-slate-300">
            <thead class="bg-slate-800 text-xs uppercase text-slate-400">
                <tr>
                    <th class="py-3.5 px-6">ID</th>
                    <th class="py-3.5 px-6">Size Name</th>
                    <th class="py-3.5 px-6">Price</th>
                    <th class="py-3.5 px-6 text-right">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="py-4 px-6">@item.Id</td>
                            <td class="py-4 px-6 font-semibold text-white">@item.SizeName</td>
                            <td class="py-4 px-6 text-indigo-400 font-bold">$@item.Price</td>
                            <td class="py-4 px-6 text-right">
                                <form asp-controller="Admin" asp-action="DeletePrice" method="post" onsubmit="return confirm('Are you sure you want to delete this print size?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="px-3 py-1.5 bg-rose-600 hover:bg-rose-500 text-white rounded-lg text-xs font-bold transition">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="py-6 text-center text-slate-500">No print sizes configured yet. Add one above!</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>