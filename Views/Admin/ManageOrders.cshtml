@model IEnumerable<DigitalPhotoPrintingSystem.Models.PhotoOrder>

@{
    ViewData["Title"] = "Manage Orders";
}

<div class="bg-slate-900 text-white py-10 px-4">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-extrabold">Manage Orders</h1>
            <p class="text-slate-400 mt-1">View, track, and manage all customer photo printing orders.</p>
        </div>
        <a href="/Admin/Dashboard" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-bold rounded-xl transition">
            &larr; Back to Dashboard
        </a>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 py-8">
    @if (TempData["Success"] != null)
    {
        <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl">
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl">
            @TempData["Error"]
        </div>
    }

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex justify-between items-center">
            <h2 class="text-lg font-bold text-slate-900">All Photo Orders</h2>
            <span class="text-xs font-semibold bg-indigo-50 text-indigo-600 px-3 py-1 rounded-full border border-indigo-100">
                Total Orders: @(Model != null ? Model.Count() : 0)
            </span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider text-xs font-semibold">
                    <tr>
                        <th class="p-4">Order ID</th>
                        <th class="p-4">Customer Name</th>
                        <th class="p-4">Email ID</th>
                        <th class="p-4">Payment Mode</th>
                        <th class="p-4">Print Size</th>
                        <th class="p-4 text-center">Qty</th>
                        <th class="p-4">Total Price</th>
                        <th class="p-4">Order Date</th>
                        <th class="p-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50 transition">
                                <td class="p-4 font-bold text-indigo-600">#@item.Id</td>
                                <td class="p-4 font-medium text-slate-800">
                                    @(!string.IsNullOrEmpty(item.CustomerName) ? item.CustomerName : "Customer")
                                </td>
                                <td class="p-4 text-slate-600">
                                    @(!string.IsNullOrEmpty(item.EmailId) ? item.EmailId : "N/A")
                                </td>
                                <td class="p-4 text-slate-600">
                                    @(string.IsNullOrEmpty(item.ModeOfPayment) ? "Direct Payment" : item.ModeOfPayment)
                                </td>
                                <td class="p-4 text-slate-600">@item.PrintSize</td>
                                <td class="p-4 text-center font-medium text-slate-700">@item.Quantity</td>
                                <td class="p-4 font-bold text-emerald-600">$@item.TotalPrice.ToString("N2")</td>
                                <td class="p-4 text-slate-500 text-xs">@item.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td class="p-4 text-right">
                                    <form asp-action="DeleteOrder" asp-controller="Admin" method="post" onsubmit="return confirm('Are you sure you want to delete this order?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="text-rose-600 hover:text-rose-800 text-xs font-bold bg-rose-50 hover:bg-rose-100 px-3 py-1.5 rounded-lg transition">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="p-8 text-center text-slate-500">
                                No orders found in the system.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>