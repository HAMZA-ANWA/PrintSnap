@{
    ViewData["Title"] = "Dashboard";
    var customer = ViewBag.Customer as DigitalPhotoPrintingSystem.Models.Customer;
    var recentOrders = ViewBag.RecentOrders as System.Collections.Generic.IEnumerable<DigitalPhotoPrintingSystem.Models.PurchaseOrder>;
}

<div class="bg-slate-900 text-white py-10 px-4">
    <div class="max-w-6xl mx-auto">
        <h1 class="text-3xl font-extrabold">Welcome, @customer?.F_Name @customer?.L_Name!</h1>
        <p class="text-slate-400 mt-1">Your photo printing dashboard — orders, payments and history in one place.</p>
    </div>
</div>

<div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Stats Cards -->
    <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
            <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-xl flex items-center justify-center text-xl mb-4">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>
            <p class="text-sm text-slate-500 font-semibold">Total Orders</p>
            <p class="text-3xl font-extrabold text-slate-900">@ViewBag.TotalOrders</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
            <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center text-xl mb-4">
                <i class="fa-solid fa-dollar-sign"></i>
            </div>
            <p class="text-sm text-slate-500 font-semibold">Total Spent</p>
            <p class="text-3xl font-extrabold text-slate-900">$@ViewBag.TotalSpent.ToString("N2")</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
            <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-xl flex items-center justify-center text-xl mb-4">
                <i class="fa-solid fa-user"></i>
            </div>
            <p class="text-sm text-slate-500 font-semibold">Account</p>
            <p class="text-xl font-extrabold text-slate-900">@customer?.Email</p>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 mt-8 overflow-hidden">
        <div class="flex justify-between items-center p-6 border-b border-slate-100">
            <h2 class="text-lg font-bold text-slate-900">Recent Orders</h2>
            <a href="/User/OrderHistory" class="text-sm font-semibold text-indigo-600 hover:text-indigo-800">View All &rarr;</a>
        </div>
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider text-xs font-semibold">
                <tr>
                    <th class="p-4">Order ID</th>
                    <th class="p-4">Payment</th>
                    <th class="p-4">Total</th>
                    <th class="p-4">Date</th>
                    <th class="p-4">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (recentOrders != null && recentOrders.Any())
                {
                    @foreach (var item in recentOrders)
                    {
                        <tr class="hover:bg-slate-50 transition">
                            <td class="p-4 font-bold text-indigo-600">#@item.Id</td>
                            <td class="p-4 text-slate-600">@item.PaymentMode</td>
                            <td class="p-4 font-semibold text-emerald-600">$@item.TotalAmount.ToString("N2")</td>
                            <td class="p-4 text-slate-600">@item.OrderDate.ToString("dd MMM yyyy")</td>
                            <td class="p-4"><span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-md text-xs font-semibold">Placed</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="p-8 text-center text-slate-400">No orders yet. Place your first print order!</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (recentOrders == null || !recentOrders.Any())
        {
            <div class="p-6 text-center">
                <a href="/PhotoOrder/Create" class="btn-glossy-shine py-3 px-8 rounded-xl text-white font-bold inline-block">
                    <i class="fa-solid fa-print"></i> Create First Order
                </a>
            </div>
        }
    </div>
</div>
